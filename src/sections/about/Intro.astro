---
import C from "../../../content.js";
import Icon from "../../components/Icon.astro";
import Stats from "../../components/Stats.astro";
import { rich } from "../../lib/text.js";

const a = C.about.intro;
---
<section class="section section--paper" id="about">
  <div class="container">
    <div class="split">
      <div class="reveal">
        <span class="kicker">{a.kicker}</span>
        {/* The page's only h1, kept at the size it had as a section heading on the home page. */}
        <h1 style="margin-top:18px;font-size:var(--fs-h2)">{a.title}</h1>
        <div class="tri-badges">{a.badges.map((b) => <span class="chip chip--red"><Icon name="check" />{b}</span>)}</div>
      </div>
      <div class="prose lead reveal" style="--delay:100ms">{a.text.map((t) => <p set:html={rich(t)}></p>)}</div>
    </div>
    <div class="about-stats"><Stats list={a.stats} /></div>
  </div>
</section>
