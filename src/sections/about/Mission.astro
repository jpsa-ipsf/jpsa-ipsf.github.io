---
import C from "../../../content.js";
import Icon from "../../components/Icon.astro";
import SectionHead from "../../components/SectionHead.astro";

const m = C.about.mission;
---
<section class="section" id="mission">
  <div class="container">
    <SectionHead kicker={m.kicker} title={m.title} />
    <div class="mv">
      <article class="mv__card mv__card--mission reveal"><Icon name="target" class="mv__icon" /><h3 class="mv__label">Mission</h3><p class="mv__text">{m.mission}</p></article>
      <article class="mv__card mv__card--vision reveal" style="--delay:100ms"><Icon name="eye" class="mv__icon" /><h3 class="mv__label">Vision</h3><p class="mv__text">{m.vision}</p></article>
    </div>
    <div class="values reveal">{m.values.map((v) => <span class="chip"><Icon name="sparkles" />{v}</span>)}</div>
  </div>
</section>
