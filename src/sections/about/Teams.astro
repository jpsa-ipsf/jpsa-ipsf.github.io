---
import C from "../../../content.js";
import Icon from "../../components/Icon.astro";
import SectionHead from "../../components/SectionHead.astro";
import TextLink from "../../components/TextLink.astro";
import { delay } from "../../lib/text.js";
---
<section class="section" id="teams">
  <div class="container">
    <SectionHead kicker="Our teams" title="Five teams. One family." lead="Every JPSA activity is run by one of our teams. Pick one to see what they do." split />
    <div class="grid grid-3">
      {C.teams.map((t, i) => <article class="item-card reveal" style={delay(i, 70, 3)}>
            <span class="icon-badge icon-badge--red"><Icon name={t.icon} /></span>
            <h3>{t.name}</h3>
            {t.leads && t.leads.length > 0 && <p><strong>Led by:</strong> {t.leads.map((l) => l.name + (l.role ? ` (${l.role})` : "")).join(", ")}</p>}
            <TextLink label={t.href.indexOf("sep") === 0 ? "Explore the exchange program" : "See what they do"} href={t.href} />
          </article>)}
    </div>
  </div>
</section>
