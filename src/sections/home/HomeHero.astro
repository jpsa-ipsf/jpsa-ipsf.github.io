---
import { Image } from "astro:assets";
import C from "../../../content.js";
import Btn from "../../components/Btn.astro";
import { img } from "../../lib/images.js";
import { pad } from "../../lib/text.js";

const h = C.home.hero;
const L = C.site.links;
// The faces behind the hero: the first 48 photos of the family wall (assets/img/family/), enough
// to fill it on any screen.
const faces = Array.from({ length: Math.min(48, C.home.wallCount) }, (_, i) => `assets/img/family/f${pad(i + 1)}.jpg`);
---
<section class="home-hero">
  {/* Decoration only, behind the text: the members' faces, and the giant JPSA at the foot (the real title is the h1). */}
  <div class="home-hero__faces" aria-hidden="true">{faces.map((src) => <Image src={img(src)} alt="" widths={[120, 240]} sizes="(max-width: 900px) 20vw, 12.5vw" quality={50} loading="lazy" fetchpriority="low" />)}</div>
  <div class="home-hero__word" aria-hidden="true"><span>J</span><span>P</span><span>S</span><span>A</span></div>
  <div class="container home-hero__grid">
    <div>
      <span class="kicker reveal">{h.kicker}</span>
      <h1 class="home-hero__title reveal" style="--delay:80ms">
        <span class="line">{h.titleLines[0]}</span>
        <span class="line">{h.titleLines[1]}<span class="dot">.</span></span>
      </h1>
      <p class="home-hero__sub reveal" style="--delay:160ms">{h.sub}</p>
      <div class="cluster home-hero__meta reveal" style="--delay:220ms">
        {h.chips.map((c, i) => <span class={`chip${i === 0 ? " chip--dark" : ""}`}>{c}</span>)}
      </div>
      <div class="cluster actions reveal" style="--delay:280ms">
        <Btn label="Join JPSA" href={L.join} />
        <Btn label="Explore our portfolios" href="portfolios.html" variant="outline" />
      </div>
    </div>
  </div>
  <div class="home-hero__grain" aria-hidden="true"></div>
</section>
