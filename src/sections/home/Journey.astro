---
import C from "../../../content.js";
import SectionHead from "../../components/SectionHead.astro";

const j = C.home.journey;
---
<section class="section section--black" id="journey">
  <div class="container">
    <SectionHead kicker={j.kicker} title={j.title} lead={j.lead} split />
    <div class="journey" role="list">
      <span class="journey__progress" aria-hidden="true"></span>
      {C.universities.map((u) => <div class="journey__item" role="listitem">
            <span class="journey__dot" aria-hidden="true"></span>
            <div class="journey__year">{u.year}</div>
            <div class="journey__abbr">{u.abbr}</div>
            <div class="journey__name">{u.name}</div>
          </div>)}
    </div>
  </div>
</section>
