---
import C from "../../../content.js";
import SectionHead from "../../components/SectionHead.astro";
import TextLink from "../../components/TextLink.astro";
import Avatar from "../../components/Avatar.astro";
import { person, leaderOf, university } from "../../lib/team.js";

const T = C.team;
const S = T.teams;
const L = S.labels;
const order = C.universities.map((u) => u.abbr);
const rank = (abbr) => (abbr ? order.indexOf(abbr) : order.length);

// Local members sorted by university (in the order of the universities list), unknown last.
const localOf = (t) => t.local
  .map((m) => ({ role: m.role, p: person(m.person, `the team "${t.name}"`) }))
  .sort((a, b) => rank(a.p.university) - rank(b.p.university));

// Which universities have at least one local coordinator today, and which have none yet.
const covered = order.filter((abbr) => S.list.some((t) => localOf(t).some((m) => m.p.university === abbr)));
const notYet = order.filter((abbr) => !covered.includes(abbr));
---
<section class="section section--paper" id="teams">
  <div class="container">
    <SectionHead kicker={S.kicker} title={S.title} lead={S.lead} split />
    <div class="coverage reveal">
      <span class="coverage__label">{L.coverage}</span>
      <ul class="coverage__list" role="list">{covered.map((abbr) => <li class="chip chip--red"><abbr title={university(abbr).name}>{abbr}</abbr></li>)}</ul>
      {notYet.length > 0 && <span class="coverage__label">{L.notYet}</span>}
      {notYet.length > 0 && <ul class="coverage__list" role="list">{notYet.map((abbr) => <li class="chip"><abbr title={university(abbr).name}>{abbr}</abbr></li>)}</ul>}
    </div>
  </div>
  <nav class="subnav" aria-label={L.jump}>
    <div class="container subnav__inner">{S.list.map((t) => <a href={`#${t.id}`} data-spy={t.id}>{t.name}</a>)}</div>
  </nav>
  <div class="container">
    {T.groups.filter((g) => S.list.some((t) => t.group === g.id)).map((g) => <div class="team-group">
      <h3 class="kicker team-group__title">{g.name}</h3>
      {S.list.filter((t) => t.group === g.id).map((t) => {
        const lead = leaderOf(t.id);
        const leader = person(lead.person, `the position "${lead.title}"`);
        const local = localOf(t);
        const committee = t.committee.map((id) => person(id, `the team "${t.name}"`));
        const count = local.length + committee.length;
        return <article class="team-card reveal" id={t.id}>
          <header class="team-card__head">
            <h4 class="team-card__name">{t.name}</h4>
            <p class="team-card__meta"><Avatar person={leader} /><span>{L.ledBy} <strong>{leader.name}</strong> · {count} {count === 1 ? L.member : L.members}</span></p>
          </header>
          <dl class="team-card__fields">
            <div><dt>{L.does}</dt><dd>{t.does}{t.work && <span class="team-card__work"><TextLink label={t.workLabel || L.work} href={t.work} /></span>}</dd></div>
            {t.now && <div><dt>{L.now}</dt><dd>{t.now}</dd></div>}
            <div><dt>{L.join}</dt><dd>{t.join}</dd></div>
          </dl>
          <div class="team-card__people">
            {local.length > 0 && <div class="team-card__group">
              <h5 class="team-card__subtitle">{L.local}</h5>
              <table class="members">
                <thead><tr><th scope="col">{L.name}</th><th scope="col">{L.role}</th><th scope="col">{L.university}</th></tr></thead>
                <tbody>{local.map((m) => <tr>
                  <td><span class="members__person"><Avatar person={m.p} />{m.p.name}</span></td>
                  <td>{m.role}</td>
                  <td>{m.p.university ? <abbr title={university(m.p.university).name}>{m.p.university}</abbr> : L.noUniversity}</td>
                </tr>)}</tbody>
              </table>
            </div>}
            {committee.length > 0 && <div class="team-card__group">
              <h5 class="team-card__subtitle">{L.committee}</h5>
              <ul class="committee" role="list">{committee.map((p) => <li><Avatar person={p} />{p.name}</li>)}</ul>
            </div>}
          </div>
        </article>;
      })}
    </div>)}
  </div>
</section>
