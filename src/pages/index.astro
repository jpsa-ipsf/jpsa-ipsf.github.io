---
import Base from "../layouts/Base.astro";
import C from "../../content.js";
import Marquee from "../components/Marquee.astro";
import CtaBand from "../components/CtaBand.astro";
import Btn from "../components/Btn.astro";
import HomeHero from "../sections/home/HomeHero.astro";
import Manifesto from "../sections/home/Manifesto.astro";
import Why from "../sections/home/Why.astro";
import FamilyWall from "../sections/home/FamilyWall.astro";

const h = C.home;
const L = C.site.links;
---
<Base page="home" {...h.meta}>
  <HomeHero />
  <Marquee items={C.universities.map((u) => u.name)} />
  <Manifesto />
  <Why />
  <FamilyWall />
  <CtaBand title={h.cta.title} text={h.cta.text}><Btn label="Join JPSA" href={L.join} variant="yellow" /><Btn label="Follow @jpsa_ipsf" href={L.instagram} variant="outline-light" iconName="instagram" /></CtaBand>
</Base>
