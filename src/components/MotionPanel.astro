---
// Development only (Base.astro shows it when import.meta.env.DEV): live controls for the motion
// layers, so they can be chosen by eye. Its style and script are inline, so nothing from it
// reaches the built site. The values are kept while moving between pages (localStorage).
//
// Four kinds of motion to compare (A is motion.css as it stands; B, C and D are trials that live
// here until one is chosen, then move into motion.css / motion.js):
//   A  tint + grain          B  soft shapes travelling across the background
//   C  a wave of light sweeping side to side          D  specks of dust rising and fading
const sliders = [
  { name: "--fx-grain", key: "grain", label: "الحُبيبات", min: 0.02, max: 0.2, step: 0.005 },
  { name: "--fx-glow-home", key: "home", label: "الشدة: هيرو الرئيسية", min: 0, max: 1, step: 0.01 },
  { name: "--fx-glow-light", key: "light", label: "الشدة: الأقسام الفاتحة", min: 0, max: 1, step: 0.01 },
  { name: "--fx-glow-dark", key: "dark", label: "الشدة: الأسود والهيرو الداخلي", min: 0, max: 1, step: 0.01 },
  { name: "--fx-glow-warm", key: "red/yellow", label: "الشدة: الأحمر والأصفر", min: 0, max: 1, step: 0.01 },
  { name: "--fx-drift", key: "cycle", label: "مدة الدورة (ثانية)", min: 8, max: 60, step: 1, unit: "s" },
  { name: "--fx-depth", key: "parallax", label: "البارالاكس", min: 0, max: 3, step: 0.05 },
];
const menuGlows = [
  { value: "red", label: "أحمر JPSA" },
  { value: "yellow", label: "أصفر" },
  { value: "both", label: "الاثنين" },
];
const menuSliders = [
  { name: "--menu-glow-strength", key: "glow", label: "شدة التوهج (بتوقف عند الحد الآمن)", min: 0.1, max: 1, step: 0.05 },
];
const wordStyles = [
  { value: "black", label: "أسود معتم" },
  { value: "red", label: "أحمر JPSA" },
  { value: "outline", label: "حدود بس" },
];
const wordSliders = [
  { name: "--word-size", key: "word size", label: "حجم الكلمة", min: 15, max: 35, step: 0.5, unit: "vw" },
  { name: "--word-opacity", key: "word opacity", label: "شفافية الكلمة", min: 0.05, max: 1, step: 0.01 },
];
const modes = [
  { value: "a", label: "A · تلوين" },
  { value: "b", label: "B · أشكال" },
  { value: "c", label: "C · موجة" },
  { value: "d", label: "D · ذرّات" },
];
const kinds = [
  { value: "home", label: "رئيسية" },
  { value: "light", label: "فاتح" },
  { value: "black", label: "أسود" },
  { value: "red", label: "أحمر" },
  { value: "yellow", label: "أصفر" },
];
---
<aside id="fx-panel" dir="rtl" aria-label="Motion tuning (development only)">
  <button type="button" class="fx-panel__toggle" data-toggle>⚙ الحركة</button>
  <div class="fx-panel__body">
    <p class="fx-panel__note" data-reduced hidden>جهازك مفعّل عليه "تقليل الحركة"، فالحركة واقفة. طفّيه من إعدادات النظام لتشوفها.</p>
    <p class="fx-panel__title">توهج زر القائمة (عرض موبايل)</p>
    <div class="fx-panel__modes fx-panel__modes--3" role="group" aria-label="لون التوهج">
      {menuGlows.map((m) => <button type="button" data-menu-glow={m.value}>{m.label}</button>)}
    </div>
    {menuSliders.map((s) => <label class="fx-panel__row">
      <span>{s.label} <output></output></span>
      <input type="range" name={s.name} min={s.min} max={s.max} step={s.step} data-key={s.key} data-unit="" />
    </label>)}
    <div class="fx-panel__actions fx-panel__actions--menu"><button type="button" data-replay-hint>شغّل النبضة مرة كمان</button></div>
    <p class="fx-panel__title">الكلمة العملاقة (الرئيسية)</p>
    <div class="fx-panel__modes fx-panel__modes--3" role="group" aria-label="شكل الكلمة">
      {wordStyles.map((w) => <button type="button" data-word={w.value}>{w.label}</button>)}
    </div>
    {wordSliders.map((s) => <label class="fx-panel__row">
      <span>{s.label} <output></output></span>
      <input type="range" name={s.name} min={s.min} max={s.max} step={s.step} data-key={s.key} data-unit={s.unit || ""} />
    </label>)}
    <p class="fx-panel__title">نوع الحركة</p>
    <div class="fx-panel__modes" role="group" aria-label="نوع الحركة">
      {modes.map((m) => <button type="button" data-mode={m.value}>{m.label}</button>)}
    </div>
    {sliders.map((s) => <label class="fx-panel__row">
      <span>{s.label} <output></output></span>
      <input type="range" name={s.name} min={s.min} max={s.max} step={s.step} data-key={s.key} data-unit={s.unit || ""} />
    </label>)}
    <label class="fx-panel__row" data-only="d">
      <span>كثافة الذرّات <output></output></span>
      <input type="range" name="dust" min="8" max="120" step="1" data-key="dust" data-unit="" />
    </label>
    <div class="fx-panel__kinds">
      {kinds.map((k) => <label><input type="checkbox" value={k.value} checked /> {k.label}</label>)}
    </div>
    <div class="fx-panel__actions">
      <button type="button" data-copy>نسخ الأرقام</button>
      <button type="button" data-reset>رجّع البداية</button>
    </div>
  </div>
</aside>
<style is:inline>
  #fx-panel { position: fixed; top: 92px; right: 12px; z-index: 2147483000; width: 300px; font: 13px/1.4 system-ui, sans-serif; color: #fff; }
  #fx-panel .fx-panel__toggle { display: block; margin-inline-start: auto; padding: 8px 14px; border: 0; border-radius: 999px; background: #111; color: #fdd82e; font: 600 13px system-ui, sans-serif; cursor: pointer; box-shadow: 0 6px 20px rgba(0,0,0,.3); }
  #fx-panel .fx-panel__body { margin-top: 8px; padding: 14px; border-radius: 14px; background: rgba(17,17,17,.94); box-shadow: 0 10px 30px rgba(0,0,0,.35); max-height: calc(100vh - 160px); overflow: auto; }
  #fx-panel.is-closed .fx-panel__body { display: none; }
  #fx-panel .fx-panel__modes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-bottom: 14px; }
  #fx-panel .fx-panel__modes button { padding: 9px 6px; border: 1px solid rgba(255,255,255,.25); border-radius: 8px; background: transparent; color: #fff; font: 600 13px system-ui, sans-serif; cursor: pointer; }
  #fx-panel .fx-panel__modes button[aria-pressed="true"] { background: #fdd82e; border-color: #fdd82e; color: #111; }
  #fx-panel .fx-panel__title { margin: 4px 0 8px; font-weight: 700; color: #fdd82e; }
  #fx-panel .fx-panel__modes--3 { grid-template-columns: repeat(3, 1fr); }
  #fx-panel .fx-panel__modes--4 { grid-template-columns: repeat(4, 1fr); }
  #fx-panel .fx-panel__modes--4 button { padding-inline: 2px; font-size: 12px; }
  #fx-panel .fx-panel__row { display: grid; gap: 4px; margin-bottom: 10px; }
  #fx-panel .fx-panel__row[hidden] { display: none; }
  #fx-panel .fx-panel__row span { display: flex; justify-content: space-between; gap: 8px; }
  #fx-panel output { font-variant-numeric: tabular-nums; color: #fdd82e; direction: ltr; }
  #fx-panel input[type="range"] { width: 100%; accent-color: #fdd82e; }
  #fx-panel .fx-panel__kinds { display: flex; flex-wrap: wrap; gap: 6px 12px; padding: 10px 0; border-top: 1px solid rgba(255,255,255,.15); }
  #fx-panel .fx-panel__kinds input { accent-color: #fdd82e; }
  #fx-panel .fx-panel__actions { display: flex; gap: 8px; }
  #fx-panel .fx-panel__actions button { flex: 1; padding: 7px; border: 1px solid rgba(255,255,255,.3); border-radius: 8px; background: transparent; color: #fff; font: 12px system-ui, sans-serif; cursor: pointer; }
  #fx-panel .fx-panel__note { margin: 0 0 10px; padding: 8px; border-radius: 8px; background: #7a0e0e; }

  #fx-panel .fx-panel__actions--menu { margin: -6px 0 14px; }

  /* ---- The menu button's inner glow: red is components.css as it stands. Each colour keeps its own cap,
     the strongest glow at which the word and the lines keep a contrast of 4.5 (measured). ---- */
  html[data-menu-glow="yellow"] .menu-toggle { --menu-glow: var(--yellow); --menu-glow-cap: 1; }
  html[data-menu-glow="both"] .menu-toggle { --menu-glow: linear-gradient(90deg, var(--red), var(--yellow)); --menu-glow-cap: 0.6; }

  /* ---- The giant word's looks (red is the default in pages.css) ---- */
  html[data-fx-word="black"] .home-hero__word { color: var(--black); }
  html[data-fx-word="outline"] .home-hero__word { color: transparent; -webkit-text-stroke: max(2px, 0.007em) rgba(255, 255, 255, 0.75); }

  /* ---- On/off per kind of section ---- */
  html.fx-off-home .home-hero::before, html.fx-off-home .home-hero > .fx-dust,
  html.fx-off-light .section:not(.section--black, .section--red, .section--yellow)::before,
  html.fx-off-light .section:not(.section--black, .section--red, .section--yellow)::after,
  html.fx-off-light .section:not(.section--black, .section--red, .section--yellow) > .fx-dust,
  html.fx-off-black :is(.page-hero, .section--black, .site-footer)::before,
  html.fx-off-black :is(.page-hero, .section--black, .site-footer)::after,
  html.fx-off-black :is(.page-hero, .section--black, .site-footer) > .fx-dust,
  html.fx-off-red :is(.section--red, .cta-band)::before, html.fx-off-red :is(.section--red, .cta-band)::after, html.fx-off-red :is(.section--red, .cta-band) > .fx-dust,
  html.fx-off-yellow .section--yellow::before, html.fx-off-yellow .section--yellow::after, html.fx-off-yellow .section--yellow > .fx-dust { display: none !important; }

  /* ---- B: soft shapes travelling across the background ----
     Two layers turn in opposite directions at different speeds, so the shapes cross paths. */
  html[data-fx-mode="b"] :is(.page-hero, .home-hero, .section, .cta-band, .site-footer)::before,
  html[data-fx-mode="b"] :is(.page-hero, .section, .cta-band, .site-footer)::after { /* the home hero's ::after is its text gradient */
    content: ""; position: absolute; inset: -45%; z-index: -1; pointer-events: none;
    opacity: calc(var(--fx-glow) * var(--fx-phone-glow));
  }
  html[data-fx-mode="b"] :is(.page-hero, .home-hero, .section, .cta-band, .site-footer)::before {
    background:
      radial-gradient(closest-side, var(--fx-a), transparent) 35% 38% / 26% 30% no-repeat,
      radial-gradient(closest-side, var(--fx-b), transparent) 68% 64% / 24% 28% no-repeat;
    animation: fx-orbit calc(var(--fx-drift) * var(--fx-phone-slow)) linear infinite;
  }
  html[data-fx-mode="b"] :is(.page-hero, .section, .cta-band, .site-footer)::after {
    background: radial-gradient(closest-side, var(--fx-a), transparent) 62% 34% / 22% 26% no-repeat;
    animation: fx-orbit-back calc(var(--fx-drift) * var(--fx-phone-slow) * 1.35) linear infinite;
  }
  @keyframes fx-orbit { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes fx-orbit-back { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }

  /* ---- C: a wide band of light sweeping from side to side and back ---- */
  html[data-fx-mode="c"] :is(.page-hero, .home-hero, .section, .cta-band, .site-footer)::before {
    inset: -10% -70%;
    background: linear-gradient(100deg, transparent 32%, var(--fx-a) 46%, var(--fx-b) 54%, transparent 68%);
    animation: fx-sweep calc(var(--fx-drift) * var(--fx-phone-slow) / 2) ease-in-out infinite alternate;
  }
  @keyframes fx-sweep { from { transform: translateX(-30%); } to { transform: translateX(30%); } }

  /* The page's depth while scrolling stays on in B and C. */
  @supports (animation-timeline: view()) {
    html[data-fx-mode="b"] :is(.section, .cta-band, .site-footer)::before {
      animation: fx-orbit calc(var(--fx-drift) * var(--fx-phone-slow)) linear infinite, fx-depth linear both; animation-timeline: auto, --fx;
    }
    html[data-fx-mode="b"] :is(.page-hero, .home-hero)::before {
      animation: fx-orbit calc(var(--fx-drift) * var(--fx-phone-slow)) linear infinite, fx-depth-top linear both; animation-timeline: auto, --fx; animation-range: normal, exit-crossing;
    }
    html[data-fx-mode="c"] :is(.section, .cta-band, .site-footer)::before {
      animation: fx-sweep calc(var(--fx-drift) * var(--fx-phone-slow) / 2) ease-in-out infinite alternate, fx-depth linear both; animation-timeline: auto, --fx;
    }
    html[data-fx-mode="c"] :is(.page-hero, .home-hero)::before {
      animation: fx-sweep calc(var(--fx-drift) * var(--fx-phone-slow) / 2) ease-in-out infinite alternate, fx-depth-top linear both; animation-timeline: auto, --fx; animation-range: normal, exit-crossing;
    }
  }

  /* ---- D: specks of dust rising slowly and fading (made by the script below) ---- */
  .section { --fx-dust: var(--red); }
  .page-hero, .home-hero, .section--black, .site-footer, .section--red, .cta-band { --fx-dust: var(--yellow); }
  .section--yellow { --fx-dust: var(--red-deep); }
  html[data-fx-mode="d"] :is(.page-hero, .home-hero, .section, .cta-band, .site-footer)::before { display: none; }
  .fx-dust { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; opacity: min(1, calc(var(--fx-glow) * 1.6 * var(--fx-phone-glow))); }
  .fx-dust i {
    position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s); border-radius: 50%;
    background: radial-gradient(circle, var(--fx-dust) 0%, transparent 70%); opacity: var(--o);
    animation: fx-rise calc(var(--fx-drift) * var(--k) * var(--fx-phone-slow)) linear var(--delay) infinite;
  }
  @keyframes fx-rise {
    0% { transform: translate3d(0, 0, 0); opacity: 0; }
    20%, 70% { opacity: var(--o); }
    100% { transform: translate3d(var(--sway), calc(-1 * var(--rise)), 0); opacity: 0; }
  }

  /* Off screen, and with reduced motion, nothing of the trials moves either. */
  html[data-fx-mode] .fx-idle::before, html[data-fx-mode] .fx-idle::after, html[data-fx-mode] .fx-idle > .fx-dust i { animation: none !important; }
  @media (prefers-reduced-motion: reduce) {
    html[data-fx-mode] :is(.page-hero, .home-hero, .section, .cta-band, .site-footer)::before,
    html[data-fx-mode] :is(.page-hero, .home-hero, .section, .cta-band, .site-footer)::after,
    .fx-dust i { animation: none !important; }
  }
</style>
<script is:inline>
  (() => {
    const KEY = "jpsa-motion-tuning";
    const root = document.documentElement;
    const panel = document.getElementById("fx-panel");
    const sliders = [...panel.querySelectorAll('input[type="range"]')];
    const cycle = panel.querySelector('input[name="--fx-drift"]');
    const density = panel.querySelector('input[name="dust"]');
    const kinds = [...panel.querySelectorAll('input[type="checkbox"]')];
    const modeButtons = [...panel.querySelectorAll("[data-mode]")];
    const wordButtons = [...panel.querySelectorAll("[data-word]")];
    const glowButtons = [...panel.querySelectorAll("[data-menu-glow]")];
    const css = getComputedStyle(root);
    const defaults = Object.fromEntries(sliders.map((s) => [s.name, parseFloat(css.getPropertyValue(s.name))]));
    defaults.dust = 60;
    defaults["--word-size"] = 23;
    defaults["--word-opacity"] = 0.65;
    defaults["--menu-glow-strength"] = 0.45;
    const CYCLES = { a: 20, b: 22, c: 16, d: 12 }; // each kind's starting speed
    let saved = {};
    try { saved = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) {}
    let mode = saved.mode || "a";
    let word = saved.word || "red";
    let menuGlow = saved.menuGlow || "red";
    // Plays the first-visit pulse again: forgets that it has played, and restarts it.
    const replayHint = () => {
      const t = document.querySelector(".menu-toggle");
      if (!t) return;
      try { localStorage.removeItem("jpsa-menu-hint"); } catch (e) {}
      t.classList.remove("is-hint");
      void t.offsetWidth;
      t.classList.add("is-hint");
      t.addEventListener("animationend", () => { try { localStorage.setItem("jpsa-menu-hint", "1"); } catch (e) {} }, { once: true });
    };
    const cycles = Object.assign({}, CYCLES, saved.cycles);

    // D: specks of dust, as small elements the CSS animates (transform and opacity only).
    const HOSTS = ".page-hero, .home-hero, .section, .cta-band, .site-footer";
    const dust = () => {
      document.querySelectorAll(".fx-dust").forEach((d) => d.remove());
      if (mode !== "d") return;
      const r = Math.random, n = Number(density.value);
      document.querySelectorAll(HOSTS).forEach((host) => {
        const box = document.createElement("div");
        box.className = "fx-dust";
        box.setAttribute("aria-hidden", "true");
        for (let i = Math.round(n * Math.min(2, host.offsetHeight / 700)); i > 0; i--) {
          const d = document.createElement("i");
          d.style.cssText = `--x:${r() * 100}%;--y:${15 + r() * 90}%;--s:${4 + r() * 9}px;--o:${0.35 + r() * 0.55};--k:${0.6 + r() * 0.8};--delay:${-r() * 20}s;--rise:${120 + r() * 260}px;--sway:${(r() - 0.5) * 50}px`;
          box.append(d);
        }
        host.prepend(box);
      });
    };

    const save = () => {
      const state = { mode, word, menuGlow, cycles, values: {}, off: kinds.filter((k) => !k.checked).map((k) => k.value), closed: panel.classList.contains("is-closed") };
      sliders.forEach((s) => { state.values[s.name] = Number(s.value); });
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
    };
    const apply = () => {
      root.dataset.fxMode = mode;
      root.dataset.fxWord = word;
      root.dataset.menuGlow = menuGlow;
      glowButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.menuGlow === menuGlow)));
      wordButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.word === word)));
      modeButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
      density.closest("label").hidden = mode !== "d";
      cycles[mode] = Number(cycle.value);
      sliders.forEach((s) => {
        if (s.name.startsWith("--")) root.style.setProperty(s.name, s.value + s.dataset.unit);
        s.closest("label").querySelector("output").textContent = s.value + s.dataset.unit;
      });
      kinds.forEach((k) => root.classList.toggle("fx-off-" + k.value, !k.checked));
      save();
    };

    sliders.forEach((s) => {
      const v = saved.values && saved.values[s.name];
      s.value = v != null ? v : defaults[s.name];
      s.addEventListener("input", apply);
    });
    cycle.value = cycles[mode];
    density.addEventListener("change", () => { apply(); dust(); });
    kinds.forEach((k) => {
      k.checked = !(saved.off || []).includes(k.value);
      k.addEventListener("change", apply);
    });
    wordButtons.forEach((b) => b.addEventListener("click", () => { word = b.dataset.word; apply(); }));
    glowButtons.forEach((b) => b.addEventListener("click", () => { menuGlow = b.dataset.menuGlow; apply(); replayHint(); }));
    panel.querySelector("[data-replay-hint]").addEventListener("click", replayHint);
    modeButtons.forEach((b) => b.addEventListener("click", () => {
      cycles[mode] = Number(cycle.value);
      mode = b.dataset.mode;
      cycle.value = cycles[mode];
      apply();
      dust();
    }));
    if (saved.closed) panel.classList.add("is-closed");
    panel.querySelector("[data-toggle]").addEventListener("click", () => { panel.classList.toggle("is-closed"); save(); });
    panel.querySelector("[data-reset]").addEventListener("click", () => {
      sliders.forEach((s) => { s.value = defaults[s.name]; });
      Object.assign(cycles, CYCLES);
      cycle.value = cycles[mode];
      kinds.forEach((k) => { k.checked = true; });
      word = "red";
      menuGlow = "red";
      apply();
      dust();
    });
    panel.querySelector("[data-copy]").addEventListener("click", async (e) => {
      const off = kinds.filter((k) => !k.checked).map((k) => k.value);
      const text = "menu glow " + menuGlow + " · word " + word + " · mode " + mode.toUpperCase() + " · " + sliders.filter((s) => mode === "d" || s !== density).map((s) => `${s.dataset.key} ${s.value}${s.dataset.unit}`).join(" · ") + " · off: " + (off.join(", ") || "none");
      try { await navigator.clipboard.writeText(text); e.target.textContent = "انتسخت ✓"; }
      catch (err) { window.prompt("الأرقام:", text); }
      setTimeout(() => { e.target.textContent = "نسخ الأرقام"; }, 1500);
    });
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) panel.querySelector("[data-reduced]").hidden = false;
    apply();
    dust();
  })();
</script>
