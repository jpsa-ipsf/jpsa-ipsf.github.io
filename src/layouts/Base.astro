---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { page, title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#9e1414">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="JPSA — Jordan Pharmaceutical Students' Association">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <link rel="icon" href="assets/img/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:opsz,wght@9..40,400..800&family=Instrument+Serif:ital@0;1&display=swap">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/pages.css">
  {/* Without JavaScript: show everything at once, keep the mobile menu reachable
      and hide the controls that would do nothing (partner filters).
      is:inline keeps this <style> inside <noscript> (Astro would otherwise move it). */}
  <noscript><style is:inline>
    .reveal{opacity:1!important;transform:none!important}
    .manifesto__line{color:var(--ink)}
    .journey__progress{width:100%}
    .filter-bar .pills{display:none}
    @media (max-width:940px){
      .site-header{position:static}
      .menu-toggle{display:none}
      .header-inner{height:auto;flex-wrap:wrap;padding-block:12px}
      .nav{position:static;opacity:1;visibility:visible;transform:none;width:100%;padding:0;border:0;box-shadow:none;background:none;flex-direction:row;flex-wrap:wrap;align-items:center;gap:8px}
      .nav-list{flex-direction:row;flex-wrap:wrap;gap:4px}
      .nav-link{width:auto;font-size:1rem;padding:10px 12px;border-bottom:0;border-radius:var(--radius-pill)}
      .nav-link[aria-current="page"]::after{left:12px;right:12px;width:auto;bottom:6px}
    }
  </style></noscript>
</head>
<body data-page={page}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" id="site-header"><Header page={page} /></header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="site-footer" id="site-footer"><Footer /></footer>
  <script>
    import "../scripts/app.js";
  </script>
</body>
</html>
