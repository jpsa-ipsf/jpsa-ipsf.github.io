---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { page, title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#9e1414">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="JPSA — Jordan Pharmaceutical Students' Association">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <link rel="icon" href="assets/img/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:opsz,wght@9..40,400..800&family=Instrument+Serif:ital@0;1&display=swap">
  <link rel="stylesheet" href="assets/css/base.css">
  <link rel="stylesheet" href="assets/css/components.css">
  <link rel="stylesheet" href="assets/css/pages.css">
</head>
<body data-page={page}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" id="site-header"><Header page={page} /></header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="site-footer" id="site-footer"><Footer /></footer>
  <noscript>
    <p style="padding:24px;font-family:system-ui;text-align:center">This website needs JavaScript to show its content. You can also find JPSA on Instagram: <a href="https://www.instagram.com/jpsa_ipsf/">@jpsa_ipsf</a>.</p>
  </noscript>
</body>
</html>
